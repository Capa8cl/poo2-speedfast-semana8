<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="cl.speedfast.gui.VentanaListaPedidos">
  <grid id="27dc6" binding="panelListaPedidos" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties>
      <preferredSize width="600" height="400"/>
    </properties>
    <border type="none"/>
    <children>
      <grid id="c8817" binding="norte" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="true" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints border-constraint="North"/>
        <properties>
          <background color="-14800581"/>
          <preferredSize width="244" height="100"/>
        </properties>
        <border type="none"/>
        <children>
          <grid id="64387" binding="panelMenu" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false">
                <preferred-size width="80" height="60"/>
              </grid>
            </constraints>
            <properties>
              <background color="-14800581"/>
              <foreground color="-1"/>
            </properties>
            <border type="none"/>
            <children>
              <component id="29a5a" class="javax.swing.JButton" binding="btnMenu">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Menú"/>
                </properties>
              </component>
            </children>
          </grid>
          <grid id="bd765" binding="panelTitulo" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="true" hgap="-1" vgap="-1">
            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false">
                <preferred-size width="400" height="-1"/>
              </grid>
            </constraints>
            <properties>
              <background color="-14800581"/>
              <foreground color="-1"/>
            </properties>
            <border type="none"/>
            <children>
              <component id="83768" class="javax.swing.JLabel" binding="txtTitulo">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <font size="22" style="1"/>
                  <foreground color="-1"/>
                  <text value="SpeedFast"/>
                </properties>
              </component>
              <component id="b02ac" class="javax.swing.JLabel" binding="txtVentana">
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <foreground color="-1"/>
                  <text value="Lista de Pedidos"/>
                </properties>
              </component>
            </children>
          </grid>
        </children>
      </grid>
      <grid id="9affd" binding="panelListado" layout-manager="GridLayoutManager" row-count="3" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints border-constraint="Center"/>
        <properties/>
        <border type="none"/>
        <children>
          <grid id="3e3c8" binding="panelBtn" layout-manager="GridLayoutManager" row-count="1" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false">
                <minimum-size width="-1" height="50"/>
                <preferred-size width="-1" height="50"/>
              </grid>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="972c" class="javax.swing.JButton" binding="btnActualizarLista">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Actualizar Lista"/>
                </properties>
              </component>
              <component id="42e43" class="javax.swing.JButton" binding="btnEditarPedido">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Editar"/>
                </properties>
              </component>
              <component id="95488" class="javax.swing.JButton" binding="btnEliminarPedido">
                <constraints>
                  <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Eliminar"/>
                </properties>
              </component>
            </children>
          </grid>
          <grid id="96121" binding="panelTabla" layout-manager="BorderLayout" hgap="0" vgap="0">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false">
                <minimum-size width="-1" height="100"/>
                <preferred-size width="-1" height="400"/>
              </grid>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <scrollpane id="d8b6a" binding="scrollTabla">
                <constraints border-constraint="Center"/>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="fdd9f" class="javax.swing.JTable" binding="tablaRegistros">
                    <constraints/>
                    <properties>
                      <preferredSize width="-1" height="-1"/>
                    </properties>
                  </component>
                </children>
              </scrollpane>
            </children>
          </grid>
          <grid id="e4f38" binding="panelFiltros" layout-manager="GridLayoutManager" row-count="2" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="7fd23" class="javax.swing.JButton" binding="btnFiltrar">
                <constraints>
                  <grid row="1" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Filtrar"/>
                </properties>
              </component>
              <component id="9487" class="javax.swing.JComboBox" binding="cbFiltroTipo">
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
              </component>
              <component id="aa527" class="javax.swing.JComboBox" binding="cbFiltroEstado">
                <constraints>
                  <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
              </component>
              <component id="dc2e5" class="javax.swing.JLabel" binding="txtTipo">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Tipo"/>
                </properties>
              </component>
              <component id="36a61" class="javax.swing.JLabel" binding="txtEstado">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Estado"/>
                </properties>
              </component>
            </children>
          </grid>
        </children>
      </grid>
    </children>
  </grid>
</form>
