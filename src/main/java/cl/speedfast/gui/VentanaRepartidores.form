<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="cl.speedfast.gui.VentanaRepartidores">
  <grid id="27dc6" binding="panelRepartidores" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="ec0" binding="norte" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="true" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints border-constraint="North"/>
        <properties>
          <background color="-14800581"/>
          <preferredSize width="244" height="100"/>
        </properties>
        <border type="none"/>
        <children>
          <grid id="a7906" binding="panelMenu" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false">
                <preferred-size width="80" height="60"/>
              </grid>
            </constraints>
            <properties>
              <background color="-14800581"/>
              <foreground color="-1"/>
            </properties>
            <border type="none"/>
            <children>
              <component id="8d6e7" class="javax.swing.JButton" binding="btnMenu">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Menú"/>
                </properties>
              </component>
            </children>
          </grid>
          <grid id="75cb9" binding="panelTitulo" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="true" hgap="-1" vgap="-1">
            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false">
                <preferred-size width="400" height="-1"/>
              </grid>
            </constraints>
            <properties>
              <background color="-14800581"/>
              <foreground color="-1"/>
            </properties>
            <border type="none"/>
            <children>
              <component id="aab58" class="javax.swing.JLabel" binding="txtTitulo">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <font size="22" style="1"/>
                  <foreground color="-1"/>
                  <text value="SpeedFast"/>
                </properties>
              </component>
              <component id="f1fda" class="javax.swing.JLabel" binding="txtVentana">
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <foreground color="-1"/>
                  <text value="Repartidores"/>
                </properties>
              </component>
            </children>
          </grid>
        </children>
      </grid>
      <grid id="d4ec9" binding="panelListado" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints border-constraint="Center"/>
        <properties/>
        <border type="none"/>
        <children>
          <grid id="e04e2" binding="panelBtn" layout-manager="GridLayoutManager" row-count="1" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false">
                <minimum-size width="-1" height="50"/>
                <preferred-size width="-1" height="50"/>
              </grid>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="9401a" class="javax.swing.JButton" binding="btnEliminarRepartidor">
                <constraints>
                  <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Eliminar"/>
                </properties>
              </component>
              <component id="45f3a" class="javax.swing.JButton" binding="btnGuardarRepartidor">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Nuevo Repartidor"/>
                </properties>
              </component>
              <component id="47a77" class="javax.swing.JButton" binding="btnActualizarLista">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Actualizar Lista"/>
                </properties>
              </component>
              <component id="62218" class="javax.swing.JButton" binding="btnEditarRepartidor">
                <constraints>
                  <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Editar"/>
                </properties>
              </component>
            </children>
          </grid>
          <grid id="46f7e" binding="panelTabla" layout-manager="BorderLayout" hgap="0" vgap="0">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false">
                <minimum-size width="-1" height="100"/>
                <preferred-size width="-1" height="400"/>
              </grid>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <scrollpane id="41fe9" binding="scrollTabla">
                <constraints border-constraint="Center"/>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="8ee1a" class="javax.swing.JTable" binding="tablaRepartidores">
                    <constraints/>
                    <properties/>
                  </component>
                </children>
              </scrollpane>
            </children>
          </grid>
        </children>
      </grid>
    </children>
  </grid>
</form>
