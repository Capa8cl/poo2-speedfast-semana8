<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="cl.speedfast.gui.VentanaPrincipal">
  <grid id="27dc6" binding="panelPrincipal" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="576" height="493"/>
    </constraints>
    <properties>
      <background color="-1"/>
      <preferredSize width="600" height="400"/>
    </properties>
    <border type="none"/>
    <children>
      <grid id="e08ca" binding="norte" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="true" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints border-constraint="North"/>
        <properties>
          <background color="-14800581"/>
          <preferredSize width="125" height="100"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="1beb9" class="javax.swing.JLabel" binding="tituloPrincipal">
