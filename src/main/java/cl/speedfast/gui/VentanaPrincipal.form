              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <foreground color="-1"/>
              <text value="Selecciona una de las opciones"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="efe5" binding="principal" layout-manager="GridLayoutManager" row-count="7" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints border-constraint="Center"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="e9878" class="javax.swing.JButton" binding="btnRegistrarPedido">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false">
                <preferred-size width="300" height="40"/>
              </grid>
            </constraints>
            <properties>
